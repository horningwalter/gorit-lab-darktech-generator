DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

HF_TOKEN=hf_...

# Remote audio worker (typically a Colab A100 notebook running remote_worker.py).
# Leave DARKTECH_REMOTE_URL empty to run audio generation on the local GPU.
# When set, the local process becomes UI + orchestration + mastering only.
DARKTECH_REMOTE_URL=
DARKTECH_REMOTE_API_KEY=
DARKTECH_REMOTE_TIMEOUT_S=600

DARKTECH_OUTPUT_DIR=./data/output_tracks
DARKTECH_CACHE_DIR=./data/model_cache
DARKTECH_REFERENCE_DIR=./data/reference_tracks

DARKTECH_CONFIG=mvp
DARKTECH_COST_HARD_CAP_USD=0.50

GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=true
